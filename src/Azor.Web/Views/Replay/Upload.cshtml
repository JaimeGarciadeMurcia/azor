@{
    ViewData["Title"] = "Subir repetición en JSON";
}

<h1>@ViewData["Title"]</h1>

<form method="post" enctype="multipart/form-data" asp-action="Upload">
    <div class="form-group">
        <label for="jsonFile">Archivo JSON de la batalla</label>
        <input type="file" class="form-control-file" id="jsonFile" name="jsonFile" accept=".json" />
    </div>
    
    <div class="form-group">
        <label for="division">División</label>
        <input type="text" class="form-control" id="division" name="division" list="divisionOptions" placeholder="Alpha" />
        <datalist id="divisionOptions">
            <option value="Alpha" />
            <option value="Bravo" />
        </datalist>
    </div>

    <div class="form-group">
        <label for="spawn">Spawn (posición inicial)</label>
        <input type="text" class="form-control" id="spawn" name="spawn" list="spawnOptions" placeholder="Norte o Sur" />
        <datalist id="spawnOptions">
            <option value="Norte" />
            <option value="Sur" />
        </datalist>
    </div>
    
    <button type="submit" class="btn btn-primary">Subir y procesar</button>
</form>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger mt-3">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <p>@error.ErrorMessage</p>
        }
    </div>
}