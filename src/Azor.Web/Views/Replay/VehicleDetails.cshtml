@model Azor.Web.Models.Entities.Vehicle

@{
    ViewData["Title"] = $"{Model.Name} - {Model.PlayerBattle?.Name}";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-6">
        <h4>Información del barco</h4>
        <ul class="list-group">
            <li class="list-group-item"><strong>Índice:</strong> @Model.Index</li>
            <li class="list-group-item"><strong>Nación/Clase/Tier:</strong> @Model.Nation / @Model.Class / @Model.Tier</li>
            <li class="list-group-item"><strong>¿Enemigo?</strong> @Model.IsEnemy</li>
            <li class="list-group-item"><strong>¿Test ship?</strong> @Model.IsTestShip</li>
            <li class="list-group-item"><strong>Captain ID:</strong> @Model.CaptainId</li>
            <li class="list-group-item"><strong>Division label:</strong> @Model.DivisionLabel</li>
            <li class="list-group-item"><strong>Relación:</strong> @Model.Relation</li>
            <li class="list-group-item"><strong>Tiempo vivido (seg):</strong> @Model.TimeLivedSecs</li>
        </ul>
    </div>
    <div class="col-md-6">
        <h4>Resultados del servidor</h4>
        <ul class="list-group">
            <li class="list-group-item"><strong>XP:</strong> @Model.ServerResults?.Xp (raw: @Model.ServerResults?.RawXp)</li>
            <li class="list-group-item"><strong>Daño total:</strong> @Model.ServerResults?.Damage</li>
            <li class="list-group-item"><strong>Muertes:</strong> @Model.ServerResults?.Kills</li>
            <li class="list-group-item"><strong>Daño recibido:</strong> @Model.ServerResults?.ReceivedDamage</li>
            <li class="list-group-item"><strong>Daño por detección:</strong> @Model.ServerResults?.SpottingDamage</li>
            <li class="list-group-item"><strong>Daño potencial:</strong> @Model.ServerResults?.PotentialDamage</li>
            <li class="list-group-item"><strong>Incendios causados:</strong> @Model.ServerResults?.FiresDealt</li>
            <li class="list-group-item"><strong>Inundaciones causadas:</strong> @Model.ServerResults?.FloodsDealt</li>
            <li class="list-group-item"><strong>Ciudadelas:</strong> @Model.ServerResults?.CitadelsDealt</li>
            <li class="list-group-item"><strong>Críticos:</strong> @Model.ServerResults?.CritsDealt</li>
            <li class="list-group-item"><strong>Distancia recorrida (km):</strong> @Model.ServerResults?.DistanceTraveled</li>
        </ul>
    </div>
</div>

<div class="mt-3">
    <h4>Logros (Awards)</h4>
    @if (Model.Achievements.Any())
    {
        <ul>@foreach (var a in Model.Achievements) { <li>@a</li> }</ul>
    }
    else { <p>Ninguno</p> }
</div>

<div class="mt-3">
    <h4>Cintas (Ribbons)</h4>
    @if (Model.Ribbons.Any())
    {
        <table class="table table-sm">
            <thead><tr><th>Nombre</th><th>Mostrar como</th><th>Cantidad</th></tr></thead>
            <tbody>
                @foreach (var r in Model.Ribbons)
                {
                    <tr><td>@r.Name</td><td>@r.DisplayName</td><td>@r.Count</td></tr>
                }
            </tbody>
        </table>
    }
    else { <p>Sin cintas</p> }
</div>

<a asp-action="Details" asp-route-id="@Model.BattleReplayId" class="btn btn-default">Volver a la partida</a>