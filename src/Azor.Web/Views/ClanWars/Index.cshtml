@using Azor.Web.Models.Entities
@model Season[]

@{
    string targetClan = "AZOR";
    ViewData["Title"] = "Control de Clan Wars";
}
<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.css" rel="stylesheet" />
<script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.20/index.global.min.js'></script>

<style>
    .fc-daygrid-day.fc-day-clan-battle-past-yes {
        background-color: #c8e6c9 !important;  /* verde suave */
    }
    .fc-daygrid-day.fc-day-clan-battle-past-no {
        background-color: #ffcdd2 !important;  /* rojo suave */
    }
    .fc-daygrid-day.fc-day-clan-battle-future {
        background-color: #e1bee7 !important;  /* violeta claro */
    }
    .fc-daygrid-day-number {
        background-color: transparent !important;
    }
</style>

<section class="d-flex flex-column align-content-center justify-content-around">
    <div class="d-flex flex-row align-content-center justify-content-center">
        <label>Temporada: </label>
        <select id="seasonSelect" autofocus>
            @foreach (Season season in Model)
            {
                <option value="@season.Id">@season.Name</option>
            }
        </select>
    </div>
    <div class="d-flex flex-row align-content-center justify-content-around">
        <div class="d-flex flex-column align-content-center">
            <p>Inicio:</p>
            <p id="startDate"></p>
        </div>
        <div class="d-flex flex-column align-content-center">
            <p>Fin:</p>
            <p id="endDate"></p>
        </div>
    </div>
</section>

<section>
    <div id='calendar'></div>
</section>

<section>
    <div id="dailyMatches" style="margin-top: 2rem;">
        <h4>Partidas del día seleccionado</h4>
        <div id="matchesList">Selecciona un día para ver las partidas.</div>
    </div>
</section>

<script src="js/clanWarsCalendar.js" defer></script>
<script>
    const seasonSelect = document.getElementById('seasonSelect');
    const startDateText = document.getElementById('startDate');
    const endDateText = document.getElementById('endDate');
    const matchesListDiv = document.getElementById('matchesList');
    let currentMatchDates = new Set();

    document.addEventListener('DOMContentLoaded', function() {
        const firstSeasonOption = Array.from(seasonSelect.options).find(opt => opt.value !== '');
        if (firstSeasonOption) {
            seasonSelect.value = firstSeasonOption.value;
            loadSeasonAndMatches(firstSeasonOption.value);
        } else {
            initCalendar();
        }
    });

    function isClanBattleDay(date) {
        const dow = date.getDay();
        return dow === 3 || dow === 4 || dow === 6 || dow === 0;
    }

    function formatYmd(date) {
        const y = date.getFullYear();
        const m = String(date.getMonth() + 1).padStart(2, '0');
        const d = String(date.getDate()).padStart(2, '0');
        return `${y}-${m}-${d}`;
    }

    seasonSelect.addEventListener('change', async function () {
        await loadSeasonAndMatches(this.value);
    });

    function formatDateForDisplay(dateString) {
        const date = new Date(dateString);
        const day = String(date.getDate()).padStart(2, '0');
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const year = date.getFullYear();
        return `${day}-${month}-${year}`;
    }

    async function loadSeasonAndMatches(seasonId) {
        if (!seasonId) {
            startDateText.textContent = '';
            endDateText.textContent = '';
            currentMatchDates.clear();
            initCalendar();
            return;
        }

        try {
            const response = await fetch(`/ClanWars/GetSeasonMatchesInfo?seasonId=${seasonId}`);
            if (!response.ok) throw new Error('Error al cargar datos de la temporada');
            const data = await response.json();

            // Mostrar fechas de inicio y fin
            startDateText.textContent = formatDateForDisplay(data.startDate);
            endDateText.textContent = formatDateForDisplay(data.endDate);

            // Guardar las fechas con partidas como Set
            currentMatchDates = new Set(data.matchDates);
            console.log('Fechas con partidas:', currentMatchDates);

            // Refrescar el calendario
            initCalendar();
        } catch (error) {
            console.error(error);
            alert('No se pudieron cargar los datos de la temporada');
            currentMatchDates.clear();
            initCalendar();
        }
    }

    async function loadMatchesForDate(dateStr) {
        try {
            const response = await fetch(`/ClanWars/GetMatchesByDate?date=${dateStr}`);
            if (!response.ok) throw new Error('Error al cargar partidas');
            const matches = await response.json();

            const container = document.getElementById('matchesList');
            if (matches.length === 0) {
                container.innerHTML = '<p>No hay partidas registradas en este día.</p>';
                return;
            }

            let html = '<ul>';
            matches.forEach(m => {
                html += `<li><strong>${m.timestamp}</strong> (${m.result}) - Mapa: ${m.map} - Div: ${m.division || '-'} - Spawn: ${m.spawn || 'Desconocido'} </li>`;
            });
            html += '</ul>';
            container.innerHTML = html;
        } catch (error) {
            console.error(error);
            container.innerHTML = '<p>Error cargando partidas</p>';
        }
    }
    
</script>